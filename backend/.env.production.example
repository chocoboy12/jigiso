# Configuration de PRODUCTION (Google Cloud Run).
# Copiez ce fichier en « .env.production », remplissez-le, puis lancez ./deploy.sh
# « .env.production » ne doit jamais être commité ni envoyé à qui que ce soit.
#
# Les valeurs sensibles (MONGODB_URI, JWT_SECRET, CLOUDINARY_API_SECRET,
# EMAIL_PASS, SMTP_PASS, ADMIN_PASSWORD, ANTHROPIC_API_KEY) sont rangées par
# deploy.sh dans Google Secret Manager, jamais en clair dans Cloud Run.

NODE_ENV=production

# Base MongoDB Atlas : la base de votre Mac n'est pas joignable depuis Internet
MONGODB_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/malirent

# Au moins 32 caractères aléatoires. Pour en générer un : openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Laissez vide : deploy.sh met l'adresse Firebase (https://PROJET.web.app).
# Avec un nom de domaine, mettez-le ici (ex. https://jigiso.ml).
CLIENT_URL=
ALLOWED_ORIGINS=

# Photos des annonces et des profils. OBLIGATOIRE en production :
# le disque de Cloud Run est effacé à chaque redémarrage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mails (Gmail : mot de passe d'application)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Numéro du compte admin (obligatoire pour npm run create-admin)
ADMIN_PHONE=
ADMIN_NOTIFICATION_EMAIL=

# Assistant MaliBot (facultatif)
ANTHROPIC_API_KEY=
