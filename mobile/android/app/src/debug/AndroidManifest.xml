<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Depuis Android 9, le trafic HTTP non chiffré est refusé par le système.
         L'API de développement tourne en http:// sur la machine hôte
         (10.0.2.2 vue depuis l'émulateur) : sans cette autorisation, chaque
         appel échoue avant même de partir, et l'app affiche « Serveur
         injoignable » alors que le serveur répond parfaitement.

         Volontairement limité au manifeste de DÉBOGAGE : la version publiée
         garde le blocage, car en production l'API doit être en HTTPS. Placer
         cette ligne dans le manifeste principal reviendrait à autoriser
         l'interception du trafic de tous les utilisateurs. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
